# このファイルをコピーして .env を作り、値を入れてください。
#   cp .env.example .env
# .env は .gitignore 済みで GitHub には上がりません。
# 公開（Cloudflare Pages）時は、同じ名前でCloudflareの「環境変数」にも登録してください。

# Formspree のフォームエンドポイント。
# https://formspree.io で登録して取得した URL を入れてください。
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# 連絡先（サイトに表示されます）。GitHubに載せないため環境変数で管理します。
PUBLIC_TEL=090-0000-0000
PUBLIC_EMAIL=your-address@example.com
