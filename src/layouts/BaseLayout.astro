---
import '../styles/global.css';
import { site, navItems } from '../data/site';
import { areaList } from '../data/areas';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'めいじ造園｜埼玉県坂戸市の造園・植木屋｜剪定・伐採・除草',
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-image.png', Astro.site);

// LocalBusiness 構造化データ（ブリーフ 4章 SEO要件）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LandscapingBusiness',
  name: site.name,
  description: site.description,
  image: ogImage.toString(),
  url: canonical.toString(),
  telephone: site.tel,
  founder: site.owner,
  address: {
    '@type': 'PostalAddress',
    addressRegion: '埼玉県',
    addressLocality: '坂戸市',
    addressCountry: 'JP',
  },
  areaServed: areaList.map((name) => ({ '@type': 'City', name })),
  knowsAbout: ['剪定', '伐採', '除草', '草刈り', '防草シート施工', '芝張り', '害虫防除'],
  priceRange: '要見積り',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: 見出し Shippori Mincho / 本文 Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="font-body text-ink bg-base">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-white focus:text-green-deep focus:px-4 focus:py-2 focus:rounded"
    >
      本文へスキップ
    </a>
    <slot />
    <style>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
