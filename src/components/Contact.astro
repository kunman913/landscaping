---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

// Formspree のエンドポイント。.env の PUBLIC_FORMSPREE_ENDPOINT を差し替えてください。
const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';
---

<section id="contact" class="py-16 md:py-24 scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4">
    <SectionHeading eyebrow="CONTACT" title="お問い合わせ" />

    <div class="mt-10 grid gap-6 md:grid-cols-5">
      {/* 連絡先 */}
      <div class="fade-in md:col-span-2 space-y-5">
        <div class="rounded-2xl bg-green-deep text-white p-6">
          <p class="text-white/80 text-sm">お電話</p>
          <a href={site.telLink} class="mt-1 block font-heading font-bold text-2xl">
            {site.tel}
          </a>
          <p class="mt-3 text-white/85 text-sm leading-relaxed">
            作業中は電話に出られないことがあります。留守番電話にメッセージをいただければ折り返しご連絡いたします。
          </p>
        </div>
        <div class="rounded-2xl bg-white ring-1 ring-green-light/20 p-6">
          <p class="text-ink/70 text-sm">メールでのご相談</p>
          <p class="mt-1 font-bold text-green-deep">お問い合わせフォームへ</p>
          <p class="mt-2 text-ink/70 text-sm">
            メールでのご相談はフォームで承っています。お庭の写真も添付いただけます。
          </p>
        </div>
      </div>

      {/* フォーム */}
      <form
        id="contact-form"
        class="fade-in md:col-span-3 rounded-2xl bg-white ring-1 ring-green-light/20 p-6 space-y-4"
        action={formEndpoint}
        method="POST"
        enctype="multipart/form-data"
      >
        {
          !formEndpoint && (
            <p class="rounded-lg bg-accent/10 text-accent text-sm p-3">
              ※ 送信を有効にするには、.env の PUBLIC_FORMSPREE_ENDPOINT に Formspree のURLを設定してください。
            </p>
          )
        }

        {/* ハニーポット: 人間には見えない罠フィールド。ボットが入力するとFormspreeが送信を破棄する */}
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        {/* 受信メールの件名（Formspree用） */}
        <input type="hidden" name="_subject" value="【めいじ造園】お問い合わせフォームより" />

        <div>
          <label for="name" class="block text-sm font-bold text-ink/90">お名前 <span class="text-accent">必須</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" maxlength="50"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="tel" class="block text-sm font-bold text-ink/90">電話番号 <span class="text-accent">必須</span></label>
          <input id="tel" name="tel" type="tel" required autocomplete="tel"
            inputmode="tel" pattern="[0-9\-]{10,20}" maxlength="20"
            placeholder="例：090-1234-5678"
            title="数字とハイフンで入力してください（例：090-1234-5678）"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="email" class="block text-sm font-bold text-ink/90">メールアドレス</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="address" class="block text-sm font-bold text-ink/90">ご住所（市区町村まで）</label>
          <input id="address" name="address" type="text" autocomplete="address-level2" maxlength="100"
            placeholder="例：坂戸市○○"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="message" class="block text-sm font-bold text-ink/90">ご相談内容 <span class="text-accent">必須</span></label>
          <textarea id="message" name="message" rows="5" required maxlength="2000"
            placeholder="例：庭の松を1本、剪定をお願いしたいです。"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500"></textarea>
        </div>

        <div>
          <label for="photo" class="block text-sm font-bold text-ink/90">写真添付（任意）</label>
          <input id="photo" name="photo" type="file" accept="image/*" multiple
            class="mt-1 w-full text-sm text-ink/80 file:mr-3 file:rounded-full file:border-0 file:bg-green-light/15 file:px-4 file:py-2 file:text-green-deep file:font-bold" />
          <p class="mt-1 text-xs text-ink/60">お庭の様子がわかる写真があると、お見積りがスムーズです。</p>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="w-full rounded-full bg-accent text-white font-bold py-3.5 text-lg hover:brightness-110 transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          この内容で送信する
        </button>
        <p class="text-xs text-ink/60 text-center">
          送信いただいた内容はお問い合わせ対応にのみ使用します。
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form) {
    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea');

    // アクセシビリティ: 検証エラー時に aria-invalid を付け、入力し直したら外す
    fields.forEach((el) => {
      el.addEventListener('invalid', () => el.setAttribute('aria-invalid', 'true'));
      el.addEventListener('input', () => {
        if (el.checkValidity()) el.removeAttribute('aria-invalid');
      });
    });

    // 二重送信防止: 検証を通過して実際に送信される時だけボタンを無効化
    form.addEventListener('submit', () => {
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.textContent = '送信中…';
      // 送信が失敗して画面が遷移しなかった場合の保険（一定時間後に戻す）
      window.setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        submitBtn.textContent = 'この内容で送信する';
      }, 10000);
    });
  }
</script>
