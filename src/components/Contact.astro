---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

// Formspree のエンドポイント。.env の PUBLIC_FORMSPREE_ENDPOINT を差し替えてください。
const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';
---

<section id="contact" class="py-16 md:py-24 scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4">
    <SectionHeading eyebrow="CONTACT" title="お問い合わせ" />

    <div class="mt-10 grid gap-6 md:grid-cols-5">
      {/* 連絡先 */}
      <div class="fade-in md:col-span-2 space-y-5">
        <div class="rounded-2xl bg-green-deep text-white p-6">
          <p class="text-white/80 text-sm">お電話</p>
          <a href={site.telLink} class="mt-1 block font-heading font-bold text-2xl">
            {site.tel}
          </a>
          <p class="mt-3 text-white/85 text-sm leading-relaxed">
            作業中は電話に出られないことがあります。留守番電話にメッセージをいただければ折り返しご連絡いたします。
          </p>
        </div>
        <div class="rounded-2xl bg-white ring-1 ring-green-light/20 p-6">
          <p class="text-ink/70 text-sm">メールでのご相談</p>
          <p class="mt-1 font-bold text-green-deep">お問い合わせフォームへ</p>
          <p class="mt-2 text-ink/70 text-sm">
            メールでのご相談はフォームで承っています。まずはお気軽にご相談ください。
          </p>
        </div>
      </div>

      {/* フォーム */}
      <form
        id="contact-form"
        class="fade-in md:col-span-3 rounded-2xl bg-white ring-1 ring-green-light/20 p-6 space-y-4"
        action={formEndpoint}
        method="POST"
      >
        {
          !formEndpoint && (
            <p class="rounded-lg bg-accent/10 text-accent text-sm p-3">
              ※ 送信を有効にするには、.env の PUBLIC_FORMSPREE_ENDPOINT に Formspree のURLを設定してください。
            </p>
          )
        }

        {/* ハニーポット: 人間には見えない罠フィールド。ボットが入力するとFormspreeが送信を破棄する */}
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        {/* 受信メールの件名（Formspree用） */}
        <input type="hidden" name="_subject" value="【めいじ造園】お問い合わせフォームより" />

        <div>
          <label for="name" class="block text-sm font-bold text-ink/90">お名前 <span class="text-accent">必須</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" maxlength="50"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="tel" class="block text-sm font-bold text-ink/90">電話番号 <span class="text-accent">必須</span></label>
          <input id="tel" name="tel" type="tel" required autocomplete="tel"
            inputmode="tel" pattern="[0-9\-]{10,20}" maxlength="20"
            placeholder="例：090-1234-5678"
            title="数字とハイフンで入力してください（例：090-1234-5678）"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="email" class="block text-sm font-bold text-ink/90">
            メールアドレス
            <span id="email-required-badge" class="hidden text-accent">必須</span>
          </label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        {/* 写真添付を希望する場合は、折り返しメール用にメールアドレスを必須化する */}
        <div class="rounded-lg bg-green-deep/[0.04] ring-1 ring-green-light/20 p-3">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input
              type="checkbox"
              id="photo-wanted"
              name="写真添付希望"
              value="希望する"
              class="mt-0.5 h-5 w-5 shrink-0 rounded border-green-light/60 text-green-deep focus:ring-green-deep"
            />
            <span class="text-sm text-ink/90">
              <span class="font-bold text-green-deep">写真を送る</span><br />
              <span class="text-ink/70 text-xs">
                チェックすると、担当から折り返しメールをお送りします。そのメールにお写真を添付いただけますとお見積りがスムーズです。（メールアドレスが必須になります）
              </span>
            </span>
          </label>
        </div>

        <div>
          <label for="address" class="block text-sm font-bold text-ink/90">ご住所（市区町村まで）</label>
          <input id="address" name="address" type="text" autocomplete="address-level2" maxlength="100"
            placeholder="例：坂戸市○○"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500" />
        </div>

        <div>
          <label for="message" class="block text-sm font-bold text-ink/90">ご相談内容 <span class="text-accent">必須</span></label>
          <textarea id="message" name="message" rows="5" required maxlength="2000"
            placeholder="例：庭の松を1本、剪定をお願いしたいです。"
            class="mt-1 w-full rounded-lg border border-green-light/40 px-3 py-2.5 focus:border-green-deep outline-none aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500"></textarea>
        </div>


        <p id="contact-error" role="alert" class="hidden rounded-lg bg-red-50 text-red-700 text-sm p-3">
          送信に失敗しました。お手数ですが、時間をおいて再度お試しいただくか、お電話でご連絡ください。
        </p>

        <button
          id="contact-submit"
          type="submit"
          class="w-full rounded-full bg-accent text-white font-bold py-3.5 text-lg hover:brightness-110 transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          この内容で送信する
        </button>
        <p class="text-xs text-ink/60 text-center">
          送信いただいた内容はお問い合わせ対応にのみ使用します。
        </p>
      </form>

      {/* 送信完了メッセージ（初期は非表示。AJAX送信成功時に表示） */}
      <div
        id="contact-success"
        role="status"
        tabindex="-1"
        class="hidden md:col-span-3 rounded-2xl bg-green-deep/[0.06] ring-1 ring-green-light/30 p-8 text-center"
      >
        <div class="mx-auto w-14 h-14 rounded-full bg-green-deep text-white flex items-center justify-center">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg
          >
        </div>
        <p class="mt-4 font-heading font-bold text-xl text-green-deep">送信ありがとうございました</p>
        <p class="mt-2 text-ink/80 leading-relaxed">
          内容を確認し、折り返しご連絡いたします。<br />
          お急ぎの場合は、お電話（{site.tel}）でもご相談いただけます。
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const successPanel = document.getElementById('contact-success');
  const errorMsg = document.getElementById('contact-error');

  if (form) {
    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea');

    // アクセシビリティ: 検証エラー時に aria-invalid を付け、入力し直したら外す
    fields.forEach((el) => {
      el.addEventListener('invalid', () => el.setAttribute('aria-invalid', 'true'));
      el.addEventListener('input', () => {
        if (el.checkValidity()) el.removeAttribute('aria-invalid');
      });
    });

    // 「写真添付可」チェック時は、折り返しメール用にメールアドレスを必須化
    const photoWanted = document.getElementById('photo-wanted') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const emailBadge = document.getElementById('email-required-badge');
    photoWanted?.addEventListener('change', () => {
      const on = photoWanted.checked;
      if (emailInput) {
        emailInput.required = on;
        if (!on) emailInput.removeAttribute('aria-invalid');
      }
      emailBadge?.classList.toggle('hidden', !on);
    });

    const setBusy = (busy: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = busy;
      if (busy) {
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = '送信中…';
      } else {
        submitBtn.removeAttribute('aria-busy');
        submitBtn.textContent = 'この内容で送信する';
      }
    };

    form.addEventListener('submit', async (e) => {
      // 送信先(Formspree)が未設定なら通常送信に任せる
      if (!form.getAttribute('action')) return;
      // ここに到達する時点でブラウザの必須・形式チェックは通過済み
      e.preventDefault();
      errorMsg?.classList.add('hidden');
      setBusy(true);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`status ${res.status}`);

        // 成功: フォームを隠して完了メッセージを表示
        form.classList.add('hidden');
        if (successPanel) {
          successPanel.classList.remove('hidden');
          successPanel.focus();
          successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch {
        // 失敗: エラーメッセージを出してボタンを戻す
        errorMsg?.classList.remove('hidden');
        setBusy(false);
      }
    });
  }
</script>
