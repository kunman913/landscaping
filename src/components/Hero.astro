---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import heroImage from '../assets/images/hero.jpg';
---

<section id="top" class="relative">
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt="めいじ造園が手がけた庭の風景"
      class="w-full h-full object-cover"
      widths={[640, 960, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-green-deep/55"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-32 text-white">
    <div class="max-w-2xl">
      <h1 class="font-heading font-bold leading-relaxed text-3xl md:text-5xl drop-shadow-sm">
        木が本来もつかたちを、<br />活かして整える。
      </h1>
      <p class="mt-6 text-base md:text-lg leading-relaxed">
        埼玉県坂戸市の造園・植木屋 めいじ造園<br />
        剪定・伐採・除草・芝生管理｜庭木一本から承ります。<br />
        戸建、駐車場、空き地、マンション、アパートまでなんでもご相談下さい。
      </p>
      <p class="mt-3 text-sm md:text-base text-white/90">
        一級造園施工管理技士 / 一級造園技能士
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a
          href={site.telLink}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-4 text-lg font-bold shadow-lg hover:brightness-110 transition"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M6.6 10.8a15.5 15.5 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.4 11.4 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.4 11.4 0 00.58 3.6 1 1 0 01-.24 1z"
            ></path></svg
          >
          お見積り無料｜{site.tel}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white/15 ring-1 ring-white/70 px-6 py-4 text-base font-bold hover:bg-white/25 transition"
        >
          メールで相談する
        </a>
      </div>
    </div>
  </div>
</section>
