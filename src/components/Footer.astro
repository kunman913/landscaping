---
import { site, navItems } from '../data/site';
---

<footer class="bg-green-deep text-white/90">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-heading font-bold text-xl text-white">めいじ造園</p>
        <p class="mt-3 text-sm leading-relaxed text-white/80">
          埼玉県坂戸市の造園・植木屋。<br />
          剪定・伐採・除草・芝生管理、庭木一本から承ります。
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            site.qualifications.map((q) => (
              <li class="rounded-full bg-white/10 px-3 py-1 text-xs">{q}</li>
            ))
          }
        </ul>
      </div>

      <div class="text-sm space-y-1.5">
        <p class="font-bold text-white">お問い合わせ</p>
        <p>代表：{site.owner}</p>
        <p>
          電話：<a href={site.telLink} class="underline underline-offset-2">{site.tel}</a>
        </p>
        <p>メール：お問い合わせフォームへ</p>
        <p>拠点：{site.base}</p>
      </div>

      <nav aria-label="フッターナビゲーション" class="text-sm">
        <p class="font-bold text-white">サイト内メニュー</p>
        <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-white/80 hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-white/15 text-center text-xs text-white/70">
      <p>&copy; {new Date().getFullYear()} めいじ造園 All rights reserved.</p>
    </div>
  </div>
</footer>
