---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import ownerImage from '../assets/images/owner.jpg';
import logoMark from '../assets/images/logo-mark.png';
---

<section id="about" class="py-16 md:py-24 scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow="ABOUT" title="代表あいさつ" />

    <div class="mt-10 md:mt-14 grid gap-8 md:grid-cols-5 items-start">
      <div class="fade-in md:col-span-2">
        <Image
          src={ownerImage}
          alt="めいじ造園 代表 山口明治"
          class="w-full rounded-2xl object-cover shadow-sm ring-1 ring-green-light/20"
          widths={[400, 700]}
          sizes="(max-width: 768px) 100vw, 350px"
          loading="lazy"
        />
        <p class="mt-3 text-center text-ink/70 text-sm">代表 {site.owner}（{site.ownerKana}）</p>
      </div>

      <div class="fade-in md:col-span-3 relative">
        {/* ロゴの透かし背景（テキスト側の中央に配置） */}
        <Image
          src={logoMark}
          alt=""
          aria-hidden="true"
          width={480}
          height={480}
          class="pointer-events-none select-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[16rem] md:w-[22rem] max-w-none opacity-[0.07] z-0"
        />
        <div class="relative z-10">
        <p class="font-heading font-bold text-xl md:text-2xl text-green-deep leading-relaxed">
          はじめまして、めいじ造園の山口明治です。
        </p>
        <div class="mt-5 space-y-4 text-ink/90 leading-relaxed">
          <p>
            老舗の造園会社で庭師として18年勤め、そこで身につけた技術を、もっと一軒一軒に近いかたちでお届けしたいと思い独立しました。
          </p>
          <p>
            得意なのは自然風剪定です。その木がもともと持っている枝ぶりを読みながら、枝先を切らない枝抜き（透かし）剪定が基本です。風と光が通るように整えます。切りすぎず、残しすぎず。数年先の姿を思い浮かべて一枝ずつ判断していくのが、この仕事のいちばん面白いところだと思っています。
          </p>
          <p>
            庭木一本の剪定から庭全体のお手入れまで、どんなに小さなご依頼でも同じ気持ちで伺います。まずはお気軽にご相談ください。
          </p>
        </div>

        <div class="mt-6 rounded-xl bg-green-deep/[0.05] p-4">
          <p class="font-bold text-green-deep">保有資格</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              site.qualifications.map((q) => (
                <li class="rounded-full bg-white ring-1 ring-green-light/30 px-3 py-1 text-sm text-ink/90">
                  {q}
                </li>
              ))
            }
          </ul>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>
