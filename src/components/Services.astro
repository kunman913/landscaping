---
import SectionHeading from './SectionHeading.astro';
import ServiceIcon from './ServiceIcon.astro';
import { services } from '../data/services';
---

<section id="services" class="py-16 md:py-24 bg-green-deep/[0.04] scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow="SERVICES" title="作業メニュー" />

    <div class="mt-10 md:mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <div class="fade-in bg-white rounded-2xl p-6 shadow-sm ring-1 ring-green-light/15 h-full">
            <div class="w-12 h-12 rounded-xl bg-green-light/15 text-green-deep flex items-center justify-center">
              <ServiceIcon name={s.icon} />
            </div>
            <h3 class="mt-4 font-heading font-bold text-xl text-green-deep">{s.title}</h3>
            <p class="mt-2 text-ink/90 leading-relaxed">{s.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
