---
import { Image } from 'astro:assets';
import { site, navItems } from '../data/site';
import logoMark from '../assets/images/logo-mark.png';
---

<header class="sticky top-0 z-40 bg-base/95 backdrop-blur border-b border-green-light/30">
  <div class="mx-auto max-w-screen-2xl px-4 md:px-6 min-h-[4rem] md:min-h-[5rem] py-2 flex items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2.5 shrink-0" aria-label="めいじ造園 トップへ">
      <Image
        src={logoMark}
        alt="めいじ造園 ロゴ"
        class="h-11 w-11 md:h-14 md:w-14"
        width={112}
        height={112}
        loading="eager"
      />
      <span class="font-heading text-2xl md:text-3xl font-bold text-green-deep tracking-wide">
        めいじ造園
      </span>
    </a>

    <!-- PCナビ（横1行に収まる幅=1152px以上で表示。それ未満はハンバーガー） -->
    <nav class="hidden nav:block flex-1 min-w-0" aria-label="メインナビゲーション">
      <ul class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="whitespace-nowrap text-ink/80 hover:text-green-deep transition-colors py-2">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={site.telLink}
        class="hidden sm:inline-flex shrink-0 items-center gap-2 rounded-full bg-accent text-white font-bold px-4 py-2 text-sm hover:brightness-110 transition"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"
          ><path
            d="M6.6 10.8a15.5 15.5 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.4 11.4 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.4 11.4 0 00.58 3.6 1 1 0 01-.24 1z"
          ></path></svg
        >
        <span class="whitespace-nowrap text-center leading-tight">お電話は<br />こちら</span>
      </a>

      <!-- モバイル用メニュー開閉 -->
      <button
        type="button"
        id="menu-toggle"
        class="nav:hidden inline-flex items-center justify-center w-10 h-10 rounded text-green-deep"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>

  <!-- モバイルメニュー -->
  <nav
    id="mobile-menu"
    class="nav:hidden hidden border-t border-green-light/30 bg-base"
    aria-label="モバイルナビゲーション"
  >
    <ul class="px-4 py-2 divide-y divide-green-light/15">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="block py-3 text-ink/90 hover:text-green-deep" data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'メニューを開く');
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
    });
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  }
</script>
